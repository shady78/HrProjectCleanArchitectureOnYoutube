{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=HRManagementDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "w+HhfRLnVyxshA2KcZbPfj7G1ou+oR8Ojbi9hjhqsXkpKG+ZMU4DifnkWHht0mMfKWBs24L6X0AT0AqjETP5ZA==",
    "Issuer": "HRManagement.API",
    "Audience": "HRManagementSystemUser",
    "ExpirationMinutes": 15
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.MSSqlServer",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "HRManagement.Api"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] [TraceId: {TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/hrmanagement-.json",
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 30,
          "shared": false
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "restrictedToMinimumLevel": "Information",
          "sinkOptionsSection": {
            "tableName": "DeveloperLogs",
            "schemaName": "dbo",
            "autoCreateSqlDatabase": false,
            "autoCreateSqlTable": false,
            "batchPostingLimit": 50,
            "batchPeriod": "0.00:00:05",
            "eagerlyEmitFirstEvent": true,
            "useSqlBulkCopy": true,
            "enlistInTransaction": false
          },
          "columnOptionsSection": {
            "primaryKeyColumnName": "Id",
            "addStandardColumns": [
              "LogEvent",
              "TraceId",
              "SpanId"
            ],
            "removeStandardColumns": [
              "Properties"
            ],
            "id": {
              "dataType": "BigInt"
            },
            "level": {
              "dataLength": 16
            },
            "timeStamp": {
              "dataType": "DateTimeOffset",
              "convertToUtc": true,
              "allowNull": false
            },
            "traceId": {
              "dataLength": 32
            },
            "spanId": {
              "dataLength": 16
            },
            "additionalColumns": [
              {
                "ColumnName": "SourceContext",
                "PropertyName": "SourceContext",
                "DataType": "NVarChar",
                "DataLength": 256,
                "AllowNull": true
              },
              {
                "ColumnName": "RequestPath",
                "PropertyName": "RequestPath",
                "DataType": "NVarChar",
                "DataLength": 500,
                "AllowNull": true
              }
            ]
          }
        }
      }
    ]
  }
}
